FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      isoAdvectionReferenceDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Multi-step isoAdvection from the initial alpha1 (isoAdvectionReference, run by
// neofoam_verification.isoadvection for its SCHEMES) for every velocity. The
// time step follows advectorVoF (maxAlphaCo, no maxCo limit); the run ends at
// endTime with alpha stored at every writeInterval.
maxAlphaCo          0.5;

// U = U(C) in the cells and U(Cf) on boundary faces, phi = U(Cf) & Sf
velocities
{
    // oblique uniform velocity (as advectionFluxReferenceDict): 0.4 x 0.2,
    // the disc stays 1.5 cells from the boundary
    translation
    {
        type        uniform;
        value       (1 0 0.5);
        endTime     0.4;
        writeInterval 0.2;
    }
    // solid-body rotation about the y axis through (1 0 0.8), 0.21 below the
    // disc centre, by 1 rad; the disc stays inside the domain
    rotation
    {
        type        rotation;
        origin      (1 0 0.8);
        axis        (0 1 0);
        omega       1;
        endTime     1;
        writeInterval 0.5;
    }
}

