FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      reconstructionReferenceDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The settings of TwoPhaseFlow's run/benchmark/surfaceTension cases (fvSolution;
// TwoPhaseFlow's vof2IsoTol is OpenFOAM's isoFaceTol), one sub-dictionary per
// scheme, each run on the same initial alpha1.
schemes             (isoAlpha plicRDF);

isoAlpha
{
    reconstructionScheme isoAlpha;
    isoFaceTol      1e-8;
    surfCellTol     1e-8;
}

plicRDF
{
    reconstructionScheme plicRDF;
    isoFaceTol      1e-8;
    surfCellTol     1e-8;
    tol             1e-8;
    iterations      10;
    interpolateNormal false;
}

// surfaceIteratorPLIC::vofCutCell(celli, alpha, tol, maxIter, normal) for the
// signed-distance reference (plicRDF calls it with isoFaceTol and 100)
vofCutCellTol       1e-8;
vofCutCellMaxIter   100;
// targets besides the cell's own alpha
alphaTargets        (0.1 0.5 0.9);

// ************************************************************************* //
