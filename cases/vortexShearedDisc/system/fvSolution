/*--------------------------------*- C++ -*----------------------------------*\
  vortexShearedDisc (TwoPhaseFlow testsuite/advection/test-vortexShearedDisc), MULES variant.
  The testsuite selects isoAdvection/plicRDF; here TwoPhaseFlow's MULESScheme
  advects alpha. nAlphaCorr, nAlphaSubCycles and cAlpha are the testsuite's;
  MULESCorr and nLimiterIter are OpenFOAM's defaults, written out.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.water.*"
    {
        advectionScheme MULESScheme;   // TwoPhaseFlow advectorVoF: selects MULES
        nAlphaCorr      2;
        nAlphaSubCycles 1;             // MULESScheme does not sub-cycle; keep 1
        cAlpha          1;
        MULESCorr       no;
        nLimiterIter    3;
    }
}

// advectorVoF reads this dict: phi = phi0 cos(2 pi (t + dt/2)/period)
isoAdvector
{
    period          16;
}

// ************************************************************************* //
