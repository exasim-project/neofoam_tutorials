FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// reconstructionReference reads its settings from reconstructionReferenceDict.
// advectionFluxReference: isoAdvection's controls, mesh.solverDict(alpha name),
// with reconstructionReferenceDict's reconstruction settings; alpha.<scheme>
// bounds as interIsoFoam (nAlphaBounds 3, clip), alpha.<scheme>.unbounded
// neither bounds nor clips.
solvers
{
    alpha.isoAlpha
    {
        reconstructionScheme isoAlpha;
        isoFaceTol      1e-8;
        surfCellTol     1e-8;
        nAlphaBounds    3;
        clip            true;
    }

    alpha.isoAlpha.unbounded
    {
        reconstructionScheme isoAlpha;
        isoFaceTol      1e-8;
        surfCellTol     1e-8;
        nAlphaBounds    0;
        clip            false;
    }

    alpha.plicRDF
    {
        reconstructionScheme plicRDF;
        isoFaceTol      1e-8;
        surfCellTol     1e-8;
        tol             1e-8;
        iterations      10;
        interpolateNormal false;
        nAlphaBounds    3;
        clip            true;
    }

    alpha.plicRDF.unbounded
    {
        reconstructionScheme plicRDF;
        isoFaceTol      1e-8;
        surfCellTol     1e-8;
        tol             1e-8;
        iterations      10;
        interpolateNormal false;
        nAlphaBounds    0;
        clip            false;
    }

    alpha.gradAlpha
    {
        reconstructionScheme gradAlpha;
        isoFaceTol      1e-8;
        surfCellTol     1e-8;
        nAlphaBounds    3;
        clip            true;
    }

    alpha.gradAlpha.unbounded
    {
        reconstructionScheme gradAlpha;
        isoFaceTol      1e-8;
        surfCellTol     1e-8;
        nAlphaBounds    0;
        clip            false;
    }
}

