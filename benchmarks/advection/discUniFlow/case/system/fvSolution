FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The advectionModelNeoN member; the sweep's method variants set it.
advectionScheme isoAdvector;

solvers
{
    alpha.water
    {
        // isoAdvector: numufoam's controls, gradAlpha (the scheme NeoN has) for its
        // isoAlpha/plicRDF, NeoFOAM's production plane search
        reconstructionScheme gradAlpha;
        planeSearch     volTaylor;
        isoFaceTol      1e-8;
        surfCellTol     1e-8;
        nAlphaBounds    10;
        clip            false;
        snapTol         0;
        // MULES: numufoam's nAlphaCorr, nAlphaSubCycles and cAlpha, OpenFOAM's defaults
        nAlphaCorr      2;
        nAlphaSubCycles 1;
        cAlpha          1;
        MULESCorr       no;
        nLimiterIter    3;
    }
}

