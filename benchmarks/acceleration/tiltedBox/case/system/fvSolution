FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// MULES with OpenFOAM's default controls: NeoFOAM's VoF stack has no geometric VoF yet;
// the isoAdvector variant (gradAlpha, interIsoFoam's controls; TwoPhaseFlow: isoAdvection
// with plicRDF) follows with it. p_rgh as TwoPhaseFlow's tolerances.
advectionScheme MULES;

solvers
{
    "alpha.water.*"
    {
        reconstructionScheme gradAlpha;
        isoFaceTol      1e-8;
        surfCellTol     1e-8;
        nAlphaBounds    3;
        snapTol         1e-12;
        clip            true;
        nAlphaSubCycles 1;
        cAlpha          1;
        nAlphaCorr      2;
        MULESCorr       no;
        nLimiterIter    3;
    }

    p_rgh
    {
        // diagonal: NeoN maps DIC to Ginkgo's Ic, whose factorisation fails on this matrix
        solver          PCG;
        preconditioner  diagonal;
        tolerance       1e-07;
        relTol          0.05;
        maxIter         20000;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }

    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-06;
        relTol          0;
    }
}

// TwoPhaseFlow: momentumPredictor yes, nCorrectors 6; incompressibleVoFNeoN runs without
// the predictor only
PIMPLE
{
    momentumPredictor   no;
    nOuterCorrectors    1;
    nCorrectors         6;
    nNonOrthogonalCorrectors 0;
}

relaxationFactors
{
    equations
    {
        ".*" 1;
    }
}

