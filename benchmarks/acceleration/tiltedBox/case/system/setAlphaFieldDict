// The flat interface of the tilted box, numufoam's/TwoPhaseFlow's (water below z = 0.1345),
// cut exactly by the setAlphaPlane tool (NeoFOAM's setAlphaField has no plane).
field       alpha.water;
type        plane;
origin      (0 0 0.1345);
normal      (0 0 -1);

