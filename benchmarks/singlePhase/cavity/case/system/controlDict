FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     icoFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
// to the steady state: |U(t) - U(t - 2)| at t = 20 is reported (metrics.py, dU)
endTime         20;
deltaT          0.001;

writeControl    adjustableRunTime;
writeInterval   2;
purgeWrite      0;
writeFormat     ascii;
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable no;

// Co 0.5 on every mesh: dt ~ dx / 2 (the steady state does not depend on it)
adjustTimeStep  yes;
maxCo           0.5;
maxDeltaT       1;

// the NeoN executor (NeoNControlConfig); the sweep sets it
executor        Serial;

// ************************************************************************* //
