// NeoFOAM's reconstruction controls, where isoAdvectorNeoN reads them
// (read_iso_advector_controls); the sweep sets reconstructionScheme.
solvers
{
    alpha1
    {
        reconstructionScheme gradAlpha;
        isoFaceTol          1e-8;
        surfCellTol         1e-8;
    }
}

