FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    p_rgh
    {
        solver          Ginkgo;
        configFile      system/amg.json;    // CG with NeoN's MergedPgm AMG
        l1ScaledResidual true;              // OpenFOAM's normalised residual
        tolerance       1e-8;
        relTol          0.01;
        maxIter         1000;
    }
    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }
    "(U|T)"
    {
        solver          PBiCGStab;
        preconditioner  diagonal;
        tolerance       1e-10;
        relTol          0;
        maxIter         1000;
    }
    "(U|T)Final"    { $U; }
}

PIMPLE
{
    momentumPredictor yes;
    nOuterCorrectors 1;
    nCorrectors     2;
    nNonOrthogonalCorrectors 0;
    pRefCell        0;
    pRefValue       0;
}
